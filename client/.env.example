# Base URL of the Express API. "/api" works locally through the Vite dev proxy.
# In production set the full Render URL, e.g. https://your-api.onrender.com/api
VITE_API_BASE_URL=/api

# Supabase (public values only). The anon key is designed to be public, protected by RLS.
# NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


