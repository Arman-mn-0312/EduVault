# Server runtime
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when deployed behind one reverse proxy (Render), so rate limits see real client IPs
TRUST_PROXY=0


# SERVER ONLY. Never put this in client code or any VITE_* variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Uploads
MAX_FILE_SIZE_MB=25
MODERATION_ENABLED=true
SIGNED_URL_TTL_SECONDS=60

# Trusted Office text extraction limits
EXTRACTION_MAX_ENTRIES=1000
EXTRACTION_MAX_EXPANDED_MB=100
EXTRACTION_MAX_COMPRESSION_RATIO=100
EXTRACTION_MAX_SECONDS=10
EXTRACTION_MAX_CHARACTERS=200000
